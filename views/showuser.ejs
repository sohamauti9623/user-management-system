<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>users data</title>
    <style>
        table,
        th,
        td {
            border: 2px solid black;
        }
        .newbtn{
     margin: 30px;
     border: 20x;
     background-attachment: fixed;
       
        }
    </style>
</head>

<body>
    <table>
        <tr>
            <th>ID </th>
            <TH> EMAIL </TH>
            <th> USERNAME </th>
            <TH>  ADD NEW USER  <form method="GET" action="/user/new">
        <button class="newbtn" >NEW</button>
    </form></TH>
               <!-- NEW USER -->
   
        </tr>
        <% for (user of user){ %>
            <tr>
                <td>
                    <%=user.id%>
                </td>
                <td>
                    <%=user.email%>
                </td>
                <td>
                    <%=user.username%>
                </td>
               <td>
    <!-- EDIT -->
    <form method="GET" action="/user/<%= user.id %>/edit">
        <button>Edit</button>
    </form>

    <!-- DELETE -->
    <form method="POST" action="/user/<%= user.id %>?_method=DELETE">
        <button>Delete</button>
    </form>

 
</td>

            </tr>
            <% }%>
    </table>
</body>

</html>